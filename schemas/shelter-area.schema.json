{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiny-rescue.local/schemas/shelter-area.schema.json",
  "title": "Tiny Rescue shelter area",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nameKey", "capacity", "assets"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "nameKey": { "type": "string", "minLength": 1 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 12 },
    "navigationOrder": { "type": "integer", "minimum": 0 },
    "mapLabelKey": { "type": "string", "minLength": 1 },
    "mapPresentation": { "$ref": "#/$defs/mapPresentation" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background"],
      "properties": { "background": { "$ref": "#/$defs/path" } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "path": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*:)?(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[a-z0-9][a-z0-9./-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0.08, "maximum": 0.92 },
        "y": { "type": "number", "minimum": 0.12, "maximum": 0.88 }
      }
    },
    "mapPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette", "shape", "accentColor", "audioCue", "placement"],
      "properties": {
        "silhouette": { "enum": ["barn", "pines", "pond", "shelter", "tree"] },
        "shape": { "enum": ["arch", "circle", "leaf", "rounded-square", "wave"] },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "audioCue": {
          "type": "string",
          "pattern": "^effects\\.ambience\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landscape", "portrait"],
          "properties": {
            "landscape": { "$ref": "#/$defs/point" },
            "portrait": { "$ref": "#/$defs/point" }
          }
        }
      }
    }
  }
}
